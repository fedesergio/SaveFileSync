<ui:FluentWindow x:Class="SaveFileSync.App.Views.HistoryWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="History"
                 Width="940" Height="640"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar Title="History" ShowMaximize="False" ShowMinimize="False" />

    <StackPanel Grid.Row="1" Margin="24,0,24,8">
      <TextBlock x:Name="Header" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,0"
                 Text="Every sync keeps a version. Restoring one puts its saves back on all your PCs; the version it replaces stays in the list, so you can undo a restore." />
      <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Keep the latest" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ui:NumberBox x:Name="KeepBox" Grid.Column="1" Minimum="1" Maximum="1000" SmallChange="1" />
        <TextBlock Grid.Column="2" Text="versions restorable" VerticalAlignment="Center" Margin="8,0,12,0" />
        <ui:Button Grid.Column="3" Content="Save" HorizontalAlignment="Left" Click="OnSaveKeep" />
      </Grid>
      <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="0,6,0,0"
                 Text="Older versions are archived: the list keeps them, but their files are removed (after a 14-day wait) to save OneDrive space. Pinned versions, the latest version and each PC's current version are always kept. This setting is shared by all your PCs." />
    </StackPanel>

    <ListView x:Name="Versions" Grid.Row="2" Margin="24,0,24,8" SelectionChanged="OnSelectionChanged" SelectionMode="Single">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="Saved" Width="150" DisplayMemberBinding="{Binding When}" />
          <GridViewColumn Header="From" Width="110" DisplayMemberBinding="{Binding From}" />
          <GridViewColumn Header="What" Width="120" DisplayMemberBinding="{Binding Kind}" />
          <GridViewColumn Header="Files" Width="130" DisplayMemberBinding="{Binding Contents}" />
          <GridViewColumn Header="Status" Width="330" DisplayMemberBinding="{Binding Status}" />
        </GridView>
      </ListView.View>
    </ListView>

    <Grid Grid.Row="3" Margin="24,0,24,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="Message" Style="{StaticResource Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <ui:Button x:Name="RestoreButton" Content="Restore…" Appearance="Primary" Icon="{ui:SymbolIcon ArrowUndo24}" Click="OnRestore" Margin="0,0,8,0" />
        <ui:Button x:Name="PinButton" Content="Pin" Icon="{ui:SymbolIcon Pin24}" Click="OnPin" Margin="0,0,8,0" />
        <ui:Button x:Name="ExportButton" Content="Export…" Icon="{ui:SymbolIcon ArrowExport24}" Click="OnExport" Margin="0,0,8,0" />
        <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowClockwise24}" Click="OnRefresh" />
      </StackPanel>
    </Grid>
  </Grid>
</ui:FluentWindow>
