<ui:FluentWindow x:Class="SaveFileSync.App.Views.UnitDetailsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Game details"
                 Width="760" Height="720"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar x:Name="TitleBar" Title="Game details" ShowMaximize="False" ShowMinimize="False" />

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,0,24,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="Header" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="StatusDetail" Style="{StaticResource Secondary}" Margin="0,4,0,0" />
          </StackPanel>
          <Border x:Name="Chip" Grid.Column="1" Style="{StaticResource Chip}">
            <TextBlock x:Name="ChipText" Foreground="White" FontSize="12" />
          </Border>
        </Grid>

        <ui:InfoBar x:Name="ActionBar" Margin="0,12,0,0" IsClosable="False" />
        <WrapPanel x:Name="ActionButtons" Margin="0,8,0,0">
          <ui:Button x:Name="ResolveButton" Content="Choose version…" Appearance="Primary" Icon="{ui:SymbolIcon BranchCompare24}" Click="OnResolve" Margin="0,0,8,8" />
          <ui:Button x:Name="RestoreButton" Content="Restore saves from repository" Appearance="Primary" Click="OnRestore" Margin="0,0,8,8" />
          <ui:Button x:Name="DeleteEverywhereButton" Content="Delete on all PCs" Click="OnDeleteEverywhere" Margin="0,0,8,8" />
        </WrapPanel>

        <TextBlock Text="Name" Style="{StaticResource SectionTitle}" />
        <ui:TextBox x:Name="GameName" />

        <TextBlock Text="Save folders on this PC" Style="{StaticResource SectionTitle}" />
        <TextBlock x:Name="BindingHint" Style="{StaticResource Secondary}" FontSize="12" />
        <ItemsControl x:Name="Locations" Margin="0,8,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ui:Card Margin="0,0,0,8" Padding="12">
                <StackPanel>
                  <TextBlock FontWeight="SemiBold">
                    <Run Text="{Binding Label, Mode=OneWay}" /><Run Text="  (" /><Run Text="{Binding Id, Mode=OneWay}" /><Run Text=")" />
                  </TextBlock>
                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Folder on this PC" />
                    <ui:Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="OnBrowseLocation" Tag="{Binding}" />
                    <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon FolderOpen24}" Margin="8,0,0,0" Click="OnOpenLocation" Tag="{Binding}" ToolTip="Open folder" />
                  </Grid>
                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Text="{Binding Includes, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Include (default: **)" Margin="0,0,4,0" />
                    <ui:TextBox Grid.Column="1" Text="{Binding Excludes, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Exclude (optional)" Margin="4,0,0,0" />
                  </Grid>
                </StackPanel>
              </ui:Card>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Game process" Style="{StaticResource SectionTitle}" />
        <ui:TextBox x:Name="ProcessNames" PlaceholderText="e.g. rpcs3.exe; Ryujinx.exe" />

        <TextBlock Text="Conflict detection" Style="{StaticResource SectionTitle}" />
        <ComboBox x:Name="Granularity" />
        <TextBlock x:Name="GranularityHint" Style="{StaticResource Secondary}" FontSize="12" Margin="0,4,0,0" />

        <TextBlock Text="Backup" Style="{StaticResource SectionTitle}" />
        <WrapPanel>
          <ui:Button Content="Export latest version…" Icon="{ui:SymbolIcon ArrowExport24}" Click="OnExport" Margin="0,0,8,8" />
        </WrapPanel>
        <TextBlock Style="{StaticResource Secondary}" FontSize="12"
                   Text="Writes a copy of the latest synced saves to a folder of your choice. Older versions can be exported with 'SaveFileSync.exe export --version'." />

        <TextBlock Text="Sync" Style="{StaticResource SectionTitle}" />
        <WrapPanel>
          <ui:Button Content="Sync now" Icon="{ui:SymbolIcon ArrowSync24}" Click="OnSyncNow" Margin="0,0,8,8" />
          <ui:Button x:Name="PauseButton" Click="OnTogglePause" Margin="0,0,8,8" />
        </WrapPanel>

        <TextBlock Text="Remove" Style="{StaticResource SectionTitle}" />
        <WrapPanel>
          <ui:Button Content="Stop syncing on this PC" Click="OnRemoveHere" Margin="0,0,8,8" />
          <ui:Button Content="Remove from all PCs" Click="OnRemoveEverywhere" Margin="0,0,8,8" />
        </WrapPanel>
        <TextBlock Style="{StaticResource Secondary}" FontSize="12"
                   Text="Removing never deletes save files from your PCs. Versions already in the repository stay recoverable with 'SaveFileSync.exe export'." />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,8,24,16">
      <ui:Button Content="Close" Click="OnClose" Margin="0,0,8,0" />
      <ui:Button x:Name="SaveButton" Content="Save changes" Appearance="Primary" Click="OnSave" />
    </StackPanel>
  </Grid>
</ui:FluentWindow>
