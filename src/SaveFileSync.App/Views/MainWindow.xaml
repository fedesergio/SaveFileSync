<ui:FluentWindow x:Class="SaveFileSync.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:SaveFileSync.App.ViewModels"
                 Title="SaveFileSync"
                 Width="920" Height="640" MinWidth="640" MinHeight="420"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
  <ui:FluentWindow.Resources>
    <!-- List row: small cover, name, status. -->
    <DataTemplate x:Key="ListItemTemplate" DataType="{x:Type vm:UnitItemViewModel}">
      <ui:CardAction Margin="0,0,0,8" Click="OnUnitClicked" Tag="{Binding UnitId}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="40" Height="60" CornerRadius="4" Margin="0,0,14,0" ClipToBounds="True"
                  Background="{DynamicResource ControlFillColorSecondaryBrush}">
            <Grid>
              <ui:SymbolIcon Symbol="Games24" FontSize="20" Visibility="{Binding HasCover, Converter={StaticResource InverseBoolToVisibility}}" />
              <Image Source="{Binding Cover}" Stretch="UniformToFill" />
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
            <TextBlock Text="{Binding LastSyncText}" Style="{StaticResource Secondary}" FontSize="12" Margin="0,2,0,0" />
            <TextBlock Text="{Binding Note}" Foreground="#D9821E" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
          <Border Grid.Column="2" Style="{StaticResource Chip}" Background="{Binding State, Converter={StaticResource StateToBrush}}" Margin="12,0,0,0">
            <TextBlock Text="{Binding State, Converter={StaticResource StateToText}}" Foreground="White" FontSize="12" />
          </Border>
        </Grid>
      </ui:CardAction>
    </DataTemplate>

    <!-- Grid tile: cover with the name and the state over its lower edge. -->
    <Style x:Key="TileButton" TargetType="Button">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent" ClipToBounds="True">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="GridItemTemplate" DataType="{x:Type vm:UnitItemViewModel}">
      <Button Style="{StaticResource TileButton}" Click="OnUnitClicked" Tag="{Binding UnitId}"
              Width="172" Height="258" Margin="0,0,12,12" ToolTip="{Binding Name}"
              AutomationProperties.Name="{Binding Name}">
        <Grid Background="{DynamicResource ControlFillColorSecondaryBrush}">
          <ui:SymbolIcon Symbol="Games24" FontSize="44" Visibility="{Binding HasCover, Converter={StaticResource InverseBoolToVisibility}}" />
          <Image Source="{Binding Cover}" Stretch="UniformToFill" />
          <Border VerticalAlignment="Bottom" Padding="8,18,8,8">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#00000000" Offset="0" />
                <GradientStop Color="#E6000000" Offset="0.55" />
              </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
              <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
                <TextBlock Text="{Binding State, Converter={StaticResource StateToText}}" Foreground="#DDFFFFFF" FontSize="11" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Button>
    </DataTemplate>
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="SaveFileSync" />

    <Grid Grid.Row="1" Margin="24,8,24,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Library" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Summary}" Style="{StaticResource Secondary}" Margin="0,4,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <ui:Button Content="Add game" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Click="OnAddGame" Margin="0,0,8,0" />
        <ui:Button Content="Sync all now" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding SyncAllCommand}" Margin="0,0,8,0" />
        <ui:Button Command="{Binding ToggleViewCommand}" Margin="0,0,8,0" AutomationProperties.Name="Switch between list and grid">
          <ui:Button.Style>
            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
              <Setter Property="Icon" Value="{ui:SymbolIcon Grid24}" />
              <Setter Property="ToolTip" Value="Grid view" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsGridView}" Value="True">
                  <Setter Property="Icon" Value="{ui:SymbolIcon TextBulletListSquare24}" />
                  <Setter Property="ToolTip" Value="List view" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ui:Button.Style>
        </ui:Button>
        <ui:Button Icon="{ui:SymbolIcon History24}" ToolTip="Activity" Click="OnActivity" Margin="0,0,8,0" />
        <ui:Button Icon="{ui:SymbolIcon People24}" ToolTip="Devices" Click="OnDevices" Margin="0,0,8,0" />
        <ui:Button Icon="{ui:SymbolIcon Settings24}" ToolTip="Settings" Click="OnSettings" Margin="0,0,8,0" />
        <ui:Button Command="{Binding TogglePauseCommand}" Icon="{ui:SymbolIcon Pause24}">
          <ui:Button.Style>
            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
              <Setter Property="Content" Value="Pause" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                  <Setter Property="Content" Value="Resume" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ui:Button.Style>
        </ui:Button>
      </StackPanel>
    </Grid>

    <ui:InfoBar Grid.Row="2" Margin="24,0,24,8" Severity="Error" Title="Sync stopped"
                Message="{Binding Problem}" IsClosable="False"
                IsOpen="{Binding Problem, Converter={x:Static vm:Converters.NotNull}}" />

    <Grid Grid.Row="3" Margin="24,0,24,0">
      <TextBlock Text="No games yet. Use “Add game” to choose a save folder to sync."
                 Style="{StaticResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Visibility="{Binding HasUnits, Converter={StaticResource InverseBoolToVisibility}}" />
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Units}">
          <ItemsControl.Style>
            <Style TargetType="ItemsControl">
              <Setter Property="ItemTemplate" Value="{StaticResource ListItemTemplate}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsGridView}" Value="True">
                  <Setter Property="ItemTemplate" Value="{StaticResource GridItemTemplate}" />
                  <Setter Property="ItemsPanel">
                    <Setter.Value>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ItemsControl.Style>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <Grid Grid.Row="4" Margin="24,8,24,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Style="{StaticResource Secondary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
        <Run Text="{Binding DeviceName, Mode=OneWay}" /><Run Text=" · repository: " /><Run Text="{Binding RepositoryPath, Mode=OneWay}" /><Run Text=" · v" /><Run Text="{Binding Version, Mode=OneWay}" /><Run Text="{Binding CoversCredit, Mode=OneWay}" />
      </TextBlock>
      <CheckBox Grid.Column="1" Content="Start with Windows" IsChecked="{Binding StartWithWindows}" />
    </Grid>
  </Grid>
</ui:FluentWindow>
