<ui:FluentWindow x:Class="SaveFileSync.App.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Settings"
                 Width="720" Height="720"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar Title="Settings" ShowMaximize="False" ShowMinimize="False" />

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,0,24,8">
        <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" />

        <TextBlock Text="This PC" Style="{StaticResource SectionTitle}" />
        <ui:TextBox x:Name="DeviceName" PlaceholderText="Name shown on the other PCs" />
        <CheckBox x:Name="StartWithWindows" Content="Start with Windows" Margin="0,8,0,0" />

        <TextBlock Text="Shared folder" Style="{StaticResource SectionTitle}" />
        <TextBlock x:Name="RepositoryPath" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="0,4,0,0"
                   Text="To use a different folder, exit the app, delete config.json in the app data folder and start it again." />

        <TextBlock Text="Timing" Style="{StaticResource SectionTitle}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="140" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="Quiet period before uploading (seconds)" VerticalAlignment="Center" />
          <ui:NumberBox x:Name="QuietSeconds" Grid.Column="1" Minimum="10" Maximum="3600" SmallChange="10" />
          <TextBlock Grid.Row="1" Text="Wait after the game closes (seconds)" VerticalAlignment="Center" Margin="0,8,0,0" />
          <ui:NumberBox x:Name="ExitDelaySeconds" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="600" SmallChange="5" Margin="0,8,0,0" />
          <TextBlock Grid.Row="2" Text="Upload anyway if the game stays open but idle (minutes)" VerticalAlignment="Center" Margin="0,8,0,0" />
          <ui:NumberBox x:Name="InPlayCapMinutes" Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="1440" SmallChange="5" Margin="0,8,0,0" />
        </Grid>

        <TextBlock Text="Game library folders" Style="{StaticResource SectionTitle}" />
        <TextBlock Style="{StaticResource Secondary}" FontSize="12"
                   Text="Where games are installed on this PC (e.g. C:\Games). Used to find the save folders of games that are installed there." />
        <ListBox x:Name="Roots" Height="90" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <ui:Button Content="Add folder…" Click="OnAddRoot" Margin="0,0,8,0" />
          <ui:Button Content="Remove" Click="OnRemoveRoot" />
        </StackPanel>

        <CheckBox x:Name="AutoSetup" Margin="0,16,0,0"
                  Content="Set up games from my other PCs automatically when their save folder is found here" />
        <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="28,2,0,0"
                   Text="Only when the folder is found in exactly one place. If saves already exist here and differ, you are asked which version to keep: nothing is overwritten silently." />

        <TextBlock Text="History" Style="{StaticResource SectionTitle}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="140" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Versions to keep restorable (for games added from this PC)" VerticalAlignment="Center" />
          <ui:NumberBox x:Name="DefaultKeep" Grid.Column="1" Minimum="1" Maximum="1000" SmallChange="1" />
        </Grid>
        <CheckBox x:Name="HistoryCleanup" Margin="0,12,0,0"
                  Content="Clean up old versions once a day" />
        <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="28,2,0,0"
                   Text="Versions beyond the limit are archived (listed, but their files are removed after a 14-day wait). Each game can have its own limit in its History window." />
        <ui:Button x:Name="CleanNow" Content="Clean up now" Icon="{ui:SymbolIcon Broom24}" Click="OnCleanNow" Margin="0,8,0,0" />
        <TextBlock x:Name="CleanResult" Style="{StaticResource Secondary}" FontSize="12" Margin="0,4,0,0" />

        <TextBlock Text="Game database" Style="{StaticResource SectionTitle}" />
        <TextBlock x:Name="DatabaseStatus" Style="{StaticResource Secondary}" />
        <ProgressBar x:Name="DatabaseProgress" IsIndeterminate="True" Height="3" Margin="0,6,0,0" Visibility="Collapsed" />
        <ui:Button x:Name="UpdateDatabase" Content="Update now" Icon="{ui:SymbolIcon ArrowSync24}" Click="OnUpdateDatabase" Margin="0,8,0,0" />
        <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="0,4,0,0"
                   Text="Save locations come from the Ludusavi manifest, compiled from PCGamingWiki. It is downloaded on this PC only (about 17 MB) and checked at most once a week when you add a game." />

        <TextBlock Text="Covers and official names (optional)" Style="{StaticResource SectionTitle}" />
        <TextBlock Style="{StaticResource Secondary}" FontSize="12"
                   Text="Covers come from SteamGridDB and official names from IGDB, each with a free key of your own. Only game names (and Steam ids) are sent to these services. The keys are stored encrypted on this PC only, never in the shared folder: enter them on each PC. A cover you choose is shared with your other PCs and downloaded there without a key." />

        <TextBlock Text="SteamGridDB API key" Margin="0,12,0,4" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:PasswordBox x:Name="SgdbKey" PlaceholderText="Paste your key" />
          <ui:Button Grid.Column="1" x:Name="TestSgdb" Content="Test" Click="OnTestSgdb" Margin="8,0,0,0" />
          <ui:Button Grid.Column="2" x:Name="RemoveSgdb" Content="Remove" Click="OnRemoveSgdb" Margin="8,0,0,0" />
        </Grid>
        <TextBlock x:Name="SgdbStatus" Style="{StaticResource Secondary}" FontSize="12" Margin="0,4,0,0" />
        <ui:HyperlinkButton Content="Get a key: steamgriddb.com, Preferences, API" NavigateUri="https://www.steamgriddb.com/profile/preferences/api" Padding="0" />

        <TextBlock Text="IGDB (Twitch) client id" Margin="0,12,0,4" />
        <ui:TextBox x:Name="IgdbId" PlaceholderText="Client ID of your Twitch application" />
        <TextBlock Text="IGDB (Twitch) client secret" Margin="0,8,0,4" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:PasswordBox x:Name="IgdbSecret" PlaceholderText="Client secret" />
          <ui:Button Grid.Column="1" x:Name="TestIgdb" Content="Test" Click="OnTestIgdb" Margin="8,0,0,0" />
          <ui:Button Grid.Column="2" x:Name="RemoveIgdb" Content="Remove" Click="OnRemoveIgdb" Margin="8,0,0,0" />
        </Grid>
        <TextBlock x:Name="IgdbStatus" Style="{StaticResource Secondary}" FontSize="12" Margin="0,4,0,0" />
        <ui:HyperlinkButton Content="Get credentials: dev.twitch.tv/console (needs two-factor authentication)" NavigateUri="https://dev.twitch.tv/console/apps" Padding="0" />

        <TextBlock Text="Troubleshooting" Style="{StaticResource SectionTitle}" />
        <WrapPanel>
          <ui:Button Content="Open logs" Icon="{ui:SymbolIcon DocumentText24}" Click="OnOpenLogs" Margin="0,0,8,8" />
          <ui:Button Content="Export diagnostics…" Icon="{ui:SymbolIcon ArrowExport24}" Click="OnExportDiagnostics" Margin="0,0,8,8" />
        </WrapPanel>
        <TextBlock Style="{StaticResource Secondary}" FontSize="12"
                   Text="Diagnostics contain logs and settings, with your user name and profile path replaced by placeholders. They contain no save files." />

        <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
        <TextBlock x:Name="About" Style="{StaticResource Secondary}" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,8,24,16">
      <ui:Button Content="Cancel" Click="OnCancel" Margin="0,0,8,0" />
      <ui:Button Content="Save" Appearance="Primary" Click="OnSave" />
    </StackPanel>
  </Grid>
</ui:FluentWindow>
