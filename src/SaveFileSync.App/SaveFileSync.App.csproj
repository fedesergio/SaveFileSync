<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SaveFileSync.App</RootNamespace>
    <AssemblyName>SaveFileSync</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>SaveFileSync</Product>

    <!-- WinForms is only used for the tray icon; DPI awareness is declared in app.manifest for WPF. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>

    <!-- Single-file, self-contained publish (PLAN.md §2.4). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Compression saves ~90 MB on disk but makes the background process use ~2.5x the memory
         (assemblies are decompressed into RAM instead of being mapped): measured 113 vs 31 MB private. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms both define Application, MessageBox, etc.: only WinForms' NotifyIcon is used, fully qualified. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SaveFileSync.Core\SaveFileSync.Core.csproj" />
    <ProjectReference Include="..\SaveFileSync.Repository\SaveFileSync.Repository.csproj" />
    <ProjectReference Include="..\SaveFileSync.Manifest\SaveFileSync.Manifest.csproj" />
    <ProjectReference Include="..\SaveFileSync.Windows\SaveFileSync.Windows.csproj" />
  </ItemGroup>

</Project>
